  "quotes": [
    {
      "id": "tt0075314",
      "text": "You talkin’ to me?",
      "author": "Travis Bickle",
      "rooms": [
        "bathroom",
        "theatre"
      ],
      "source": "https://www.youtube.com/watch?v=dB_5XEMH3mc"
    },
    {
      "id": "tt0081505",
      "text": "Here’s Johnny!",
      "author": "Jack Torrance",
      "rooms": [
        "bathroom",
        "theatre"
      ],
      "source": "https://www.youtube.com/watch?v=5V61_W1O65c"
    },
    {
      "id": "tt0062622",
      "text": "I’m sorry, Dave. I’m afraid I can’t do that.",
      "author": "HAL 9000",
      "rooms": [
        "bathroom",
        "bedroom",
        "theatre"
      ],
      "source": "https://www.youtube.com/watch?v=Wy4EfdnMZ5g"
    },
    {
      "id": "tt0098904",
      "text": "Serenity now!",
      "author": "Frank Costanza",
      "rooms": [
        "bedroom",
        "bathroom",
        "tv"
      ],
      "source": "https://www.youtube.com/watch?v=YBF_fDa8c24"
    },
    {
      "id": "tt0386676",
      "text": "How the turntables…",
      "author": "Michael Scott",
      "rooms": [
        "bathroom",
        "tv"
      ],
      "source": "https://www.youtube.com/watch?v=rQwZ6z68gdI"
    },
    {
      "id": "tt0496424",
      "text": "I want to go to there.",
      "author": "Liz Lemon",
      "rooms": [
        "bedroom",
        "tv"
      ],
      "source": "https://www.youtube.com/watch?v=8pEjiQ634to"
    },
    {
      "id": "tt0487831",
      "text": "Have you tried turning it off and on again?",
      "author": "Roy Trenneman",
      "rooms": [
        "bathroom",
        "tv"
      ],
      "source": "https://www.youtube.com/watch?v=01jnXkUaX1E"
    },
    {
      "id": "tt0133093",
      "text": "There is no spoon.",
      "author": "Spoon Boy",
      "rooms": [
        "theatre",
        "bedroom"
      ],
      "source": "https://www.youtube.com/watch?v=M95uj0dEgUY"
    },
    {
      "id": "tt0057012",
      "text": "Gentlemen, you can’t fight in here! This is the War Room!",
      "author": "President Merkin Muffley",
      "rooms": [
        "theatre",
        "bathroom"
      ],
      "source": "https://www.youtube.com/watch?v=WI5B7jLWZUc"
    },
    {
      "id": "tt0072500",
      "text": "Don’t mention the war!",
      "author": "Basil Fawlty",
      "rooms": [
        "tv",
        "bedroom"
      ],
      "source": "https://www.youtube.com/watch?v=yfl6Lu3xQW0"
    },
    {
      "id": "tt12004706",
      "text": "Dekh raha hai Binod?",
      "author": "Bhushan",
      "rooms": [
        "tv",
        "bedroom"
      ],
      "source": "https://www.youtube.com/watch?v=M_x7t9RkFc8&t=118s"
    },
    {
      "id": "tt0098936",
      "text": "A damn fine cup of coffee.",
      "author": "Dale Cooper",
      "rooms": [
        "tv"
      ],
      "source": "https://www.youtube.com/watch?v=rpqIZmTmC5U"
    },
    {
      "id": "tt0903747",
      "text": "I am the one who knocks.",
      "author": "Walter White",
      "rooms": [
        "tv",
        "bedroom"
      ],
      "source": "https://www.youtube.com/watch?v=zAjJYkUnTEs"
    },
    {
      "id": "tt0172495",
      "text": "Are you not entertained?",
      "author": "Maximus",
      "rooms": [
        "theatre"
      ],
      "source": "https://www.youtube.com/watch?v=HmdpjkM3onk"
    },
    {
      "id": "tt0068646",
      "text": "I believe in America.",
      "author": "Amerigo Bonasera",
      "rooms": [
        "theatre"
      ],
      "source": "https://www.youtube.com/watch?v=eZHsmb4ezEk"
    },
    {
      "id": "tt0111161",
      "text": "Get busy living or get busy dying.",
      "author": "Andy Dufresne",
      "rooms": [
        "theatre"
      ],
      "source": "https://www.youtube.com/watch?v=T2bE_Abo0q0"
    },
    {
      "id": "tt0080684",
      "text": "Do. Or do not. There is no try.",
      "author": "Yoda",
      "rooms": [
        "theatre"
      ],
      "source": "https://www.starwars.com/databank/Yoda"
    },
    {
      "id": "tt0245429",
      "text": "Once you’ve met someone, you never really forget them.",
      "author": "Zeniba",
      "rooms": [
        "bedroom",
        "theatre"
      ],
      "source": "https://www.youtube.com/shorts/X1LUxt0KYdk"
    }
  ],
  "memes": [
    {
      "id": "tt0210613",
      "caption": "Went to the fair. Missed my century.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0249174",
      "caption": "Spent longer finding a runway than actually flying.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0184666",
      "caption": "Traveled seven years to put off doing the Water Temple.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0210061",
      "caption": "Signed up to save the world. Got cast in an opera.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0217733",
      "caption": "Saved up for a bicycle. My wallet stops one coin short.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0478230",
      "caption": "Half my Pokémon team works in maritime transport.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0263641",
      "caption": "Stepped into the Dark World. Apparently I’m a rabbit now.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0180825",
      "caption": "Spent the equipment budget on one excellent cardboard box.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0365498",
      "caption": "Camouflage report: the uniform matches. The waving crocodile hat does not.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0486673",
      "caption": "The mountain moved. I’m still holding its ankle.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0420798",
      "caption": "Spent the whole night choosing underglow. Still last on the grid.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt2315506",
      "caption": "Won another block of Coast City. Still riding the bus home with my PSP.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0357718",
      "caption": "Brought two SMGs. Forgot I might need a free hand for grenades.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0374692",
      "caption": "Gravity gun acquired. Every radiator is coming with me.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt0397042",
      "caption": "Saved Ashley. Kept the village eggs. Priorities.",
      "rooms": [
        "retro"
      ]
    },
    {
      "id": "tt6161168",
      "caption": "Main quest tomorrow. The horse needs brushing.",
      "rooms": [
        "gaming"
      ]
    },
    {
      "id": "tt10562854",
      "caption": "Put my runes in a safe place. Under the boss.",
      "rooms": [
        "gaming"
      ]
    },
    {
      "id": "tt14321832",
      "caption": "We agreed on a plan. Apparently each of us heard a different plan.",
      "rooms": [
        "gaming"
      ]
    },
    {
      "id": "tt7651352",
      "caption": "My GPS is the wind. Today I followed a fox instead.",
      "rooms": [
        "gaming"
      ]
    },
    {
      "id": "tt4795016",
      "caption": "Found the shortcut to the bonfire. Immediately needed the bonfire.",
      "rooms": [
        "gaming"
      ]
    },
    {
      "id": "tt5807606",
      "caption": "One more parcel. There’s definitely room above my head.",
      "rooms": [
        "gaming"
      ]
    },
    {
      "id": "tt9459718",
      "caption": "Family dinner postponed. Dad is camping the exit again.",
      "rooms": [
        "gaming"
      ]
    },
    {
      "id": "tt4044024",
      "caption": "The tall machine is a map. Naturally I have to climb it.",
      "rooms": [
        "gaming"
      ]
    },
    {
      "id": "tt21047286",
      "caption": "Moved the shotgun two squares. The attaché case finally closes.",
      "rooms": [
        "gaming"
      ]
    },
    {
      "id": "tt1648163",
      "caption": "Our co-op test results are in. One of us moved the portal.",
      "rooms": [
        "gaming"
      ]
    }
  ]
}
